{
    "ros.distro": "jazzy",
    "filewatcher.commands": [
        {
            "match": "\\.xacro*$",
            "isAsync": true,
            "cmd": "/bin/bash -c 'source /opt/ros/jazzy/setup.sh && source ${workspaceRoot}/install/setup.bash && xacro ${workspaceRoot}/src/repo_name_description/urdf/robot.urdf.xacro > ${workspaceRoot}/src/repo_name_description/urdf/robot.urdf namespace:=$ROS_NAMESPACE'",
            "event": "onFileChange"
        }
    ],
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "/opt/ros/jazzy/local/lib/python3.12/dist-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "/opt/ros/jazzy/local/lib/python3.12/dist-packages"
    ]
}